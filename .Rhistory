# 1. Cargar la librería necesaria
# (Si te da error, recuerda ejecutar primero: install.packages("wordcloud2"))
library(wordcloud2)
# 2. Crear los datos con las frecuencias correctas (manteniendo los espacios)
datos <- data.frame(
word = c("SABERES", "SOLIDARIDAD", "RELEVO GENERACIONAL", "IDENTIDAD CULTURAL",
"SOSTENIBILIDAD", "CONSTRUCCIÓN IDENTIDADES", "PÉRDIDA INFANCIA",
"BELLEZA", "PESCARTES", "PAPEL INVISIBLE MUJERES", "SALINAS UNIVERSO SOCIAL"),
freq = c(6, 6, 4, 4, 4, 2, 2, 2, 1, 1, 1)
)
# 3. Generar la nube de palabras con diseño sobrio y profesional
# - Se usa una paleta de tonos azules y grises.
# - minRotation y maxRotation a -pi/2 fuerzan que las palabras estén rectas (horizontales o verticales).
mi_nube <- wordcloud2(data = datos,
size = 0.8,
color = rep(c("#1B4F72", "#2874A6", "#3498DB", "#85C1E9", "#B2BABB"), length.out = nrow(datos)),
backgroundColor = "white",
shape = 'square',
minRotation = -pi/2,
maxRotation = -pi/2,
rotateRatio = 0.4)
# 4. Mostrar la nube
mi_nube
