size = 24,
face = "bold",
color = "#253653",
hjust = 0.5,
margin = margin(b = 12)
),
plot.subtitle = element_text(
size = 13,
color = "#607087",
hjust = 0.5,
margin = margin(b = 20)
),
plot.caption = element_text(
size = 10,
color = "#718096",
hjust = 0.5,
lineheight = 1.4,
margin = margin(t = 25)
),
legend.position = "bottom",
legend.box = "horizontal",
legend.title = element_text(
size = 11,
face = "bold",
color = "#253653"
),
legend.text = element_text(
size = 10,
color = "#46566B"
),
legend.key = element_rect(
fill = "#F5F7FA",
color = NA
),
plot.margin = margin(
35, 45, 30, 45
)
)
# ============================================================
# VISUALIZACIÓN CIENTÍFICA
# Análisis de contenido - Taller de Cabo de Gata
# ============================================================
library(ggplot2)
library(ggwordcloud)
library(dplyr)
# ------------------------------------------------------------
# 1. DATOS Y FRECUENCIAS
# ------------------------------------------------------------
categorias <- data.frame(
categoria = c(
"SOLIDARIDAD",
"SABERES",
"PÉRDIDA",
"RELEVO-GENERACIONAL",
"CONSTRUCCIÓN-IDENTIDADES",
"IDENTIDAD-CULTURAL",
"BELLEZA",
"INFANCIA",
"SOSTENIBILIDAD",
"PAPEL-INVISIBLE-MUJERES",
"SALINAS-UNIVERSO-SOCIAL",
"PESCARTES"
),
frecuencia = c(
6, 6, 3, 4, 2, 4,
2, 3, 4, 1, 1, 1
)
)
# Comprobar datos
stopifnot(
nrow(categorias) == 12,
sum(categorias$frecuencia) == 37,
!anyDuplicated(categorias$categoria)
)
# ------------------------------------------------------------
# 2. CLASIFICACIÓN DE FRECUENCIAS
# ------------------------------------------------------------
categorias <- categorias %>%
mutate(
nivel = factor(
frecuencia,
levels = c(1, 2, 3, 4, 6),
labels = c(
"1 aparición",
"2 apariciones",
"3 apariciones",
"4 apariciones",
"6 apariciones"
)
)
)
# ------------------------------------------------------------
# 3. PALETA CROMÁTICA
# ------------------------------------------------------------
paleta <- c(
"1 aparición" = "#AAB7C4",
"2 apariciones" = "#D6A64F",
"3 apariciones" = "#68A99A",
"4 apariciones" = "#32899A",
"6 apariciones" = "#344B82"
)
# ------------------------------------------------------------
# 4. GENERACIÓN DE LA NUBE
# ------------------------------------------------------------
set.seed(2026)
nube <- ggplot(
categorias,
aes(
label = categoria,
size = frecuencia,
color = nivel
)
) +
geom_text_wordcloud(
area_corr = TRUE,
rm_outside = TRUE,
shape = "circle",
eccentricity = 0.65,
grid_size = 5,
family = "sans"
) +
scale_size_area(
max_size = 37,
breaks = c(1, 2, 3, 4, 6),
name = "Frecuencia"
) +
scale_color_manual(
values = paleta,
name = "Repeticiones",
drop = FALSE
) +
coord_equal() +
labs(
title = "IMAGINARIOS Y CATEGORÍAS SOCIALES",
subtitle = paste(
"Análisis de contenido",
"Primera dinámica del taller de Cabo de Gata"
),
caption = paste(
"Fuente: elaboración propia a partir de las categorías",
"del análisis de contenido.",
"\nEl tamaño y el color representan la frecuencia de aparición."
)
) +
theme_void() +
theme(
plot.background = element_rect(
fill = "#F5F7FA",
color = NA
),
panel.background = element_rect(
fill = "#F5F7FA",
color = NA
),
plot.title = element_text(
size = 24,
face = "bold",
color = "#253653",
hjust = 0.5,
margin = margin(b = 12)
),
plot.subtitle = element_text(
size = 13,
color = "#607087",
hjust = 0.5,
margin = margin(b = 20)
),
plot.caption = element_text(
size = 10,
color = "#718096",
hjust = 0.5,
lineheight = 1.4,
margin = margin(t = 25)
),
legend.position = "bottom",
legend.box = "horizontal",
legend.title = element_text(
size = 11,
face = "bold",
color = "#253653"
),
legend.text = element_text(
size = 10,
color = "#46566B"
),
legend.key = element_rect(
fill = "#F5F7FA",
color = NA
),
plot.margin = margin(
35, 45, 30, 45
)
)
# ------------------------------------------------------------
# 5. MOSTRAR GRÁFICO
# ------------------------------------------------------------
print(nube)
# ------------------------------------------------------------
# 6. EXPORTAR PNG EN ALTA RESOLUCIÓN
# ------------------------------------------------------------
ggsave(
filename = "Cabo_Gata_Categorias.png",
plot = nube,
width = 16,
height = 13,
units = "in",
dpi = 500,
bg = "#F5F7FA"
)
# ------------------------------------------------------------
# 7. EXPORTAR PDF
# ------------------------------------------------------------
ggsave(
filename = "Cabo_Gata_Categorias.pdf",
plot = nube,
width = 16,
height = 13,
units = "in",
bg = "#F5F7FA"
)
# ------------------------------------------------------------
# 8. TABLA DE FRECUENCIAS
# ------------------------------------------------------------
tabla_frecuencias <- categorias %>%
arrange(desc(frecuencia)) %>%
mutate(
porcentaje = round(
frecuencia / sum(frecuencia) * 100,
2
)
)
print(tabla_frecuencias)
# ------------------------------------------------------------
# 9. RESUMEN FINAL
# ------------------------------------------------------------
cat("\n====================================")
cat("\nVISUALIZACIÓN GENERADA")
cat("\nCategorías:", nrow(categorias))
cat("\nApariciones:", sum(categorias$frecuencia))
cat("\n====================================\n")
