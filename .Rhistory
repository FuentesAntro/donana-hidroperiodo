library(wordcloud2)
# 2. Crear los datos con las frecuencias correctas de tu lista (sin guiones)
datos <- data.frame(
word = c("SOLIDARIDAD", "SABERES", "RELEVO GENERACIONAL", "IDENTIDAD CULTURAL",
"SOSTENIBILIDAD", "PÉRDIDA", "INFANCIA", "CONSTRUCCIÓN IDENTIDADES",
"BELLEZA", "PAPEL INVISIBLE MUJERES", "SALINAS UNIVERSO SOCIAL", "PESCARTES"),
freq = c(6, 6, 4, 4, 4, 3, 3, 2, 2, 1, 1, 1)
)
# 3. Generar la nube de palabras con diseño sobrio y profesional
# - Se usa una paleta de tonos azules y grises.
# - minRotation y maxRotation a -pi/2 fuerzan que las palabras estén rectas (horizontales o verticales).
# - size = 0.5 evita que se recorten palabras por falta de espacio.
mi_nube <- wordcloud2(data = datos,
size = 0.5,
color = rep(c("#1B4F72", "#2874A6", "#3498DB", "#85C1E9", "#B2BABB"), length.out = nrow(datos)),
backgroundColor = "white",
shape = 'square',
minRotation = -pi/2,
maxRotation = -pi/2,
rotateRatio = 0.4)
# 4. Mostrar la nube
mi_nube
