# 1. Instala los paquetes si aún no los tienes
# install.packages("wordcloud2")
# install.packages("htmlwidgets")
# install.packages("webshot")
# webshot::install_phantomjs() # Necesario para guardar la imagen
library(wordcloud2)
library(htmlwidgets)
library(webshot)
# 2. Crea el dataframe con las palabras exactas (CON espacios, SIN guiones)
datos <- data.frame(
word = c("SABERES", "SOLIDARIDAD", "RELEVO GENERACIONAL", "IDENTIDAD CULTURAL",
"SOSTENIBILIDAD", "CONSTRUCCIÓN IDENTIDADES", "PÉRDIDA INFANCIA",
"BELLEZA", "PESCARTES", "PAPEL INVISIBLE MUJERES", "SALINAS UNIVERSO SOCIAL"),
freq = c(6, 6, 4, 4, 4, 2, 2, 2, 1, 1, 1)
)
# 3. Genera la nube de palabras con un diseño profesional
# - rotateRatio: mezcla palabras horizontales y verticales (0.3 = 30% en vertical)
# - color: usa una paleta de colores oscuros aleatorios para mayor legibilidad
mi_nube <- wordcloud2(data = datos,
size = 0.8,
color = 'random-dark',
backgroundColor = "white",
shape = 'circle',
rotateRatio = 0.3)
# Mostrar la nube en el visor de RStudio
mi_nube
# 4. Exportar la nube como imagen de alta calidad (.png) para enviársela a David
saveWidget(mi_nube, "nube_temporal.html", selfcontained = F)
webshot("nube_temporal.html", "nube_cabo_de_gata.png", delay = 5, vwidth = 1000, vheight = 800)
install.packages("webshot2")
